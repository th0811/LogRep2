<!--
  メイン画面。ヘッダー（濃紺）／本文カード群／フッターの3段構成。
  見出しは SectionLabelStyle、数値は ValueTextStyle（等幅数字・右揃え）。
  共通スタイルは Theme/Styles.xaml を参照。
-->
<Window x:Class="FfxiTempLogCollector.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="LogRep2"
        Icon="pack://application:,,,/LogRep2;component/app.ico"
        Height="760"
        Width="1000"
        MinHeight="520"
        MinWidth="720"
        FontFamily="{StaticResource UiFontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded"
        StateChanged="OnStateChanged"
        Closing="OnClosing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </Window.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== ヘッダー（既存踏襲） ===== -->
        <Border Grid.Row="0" Padding="20,10" Background="{StaticResource HeaderNavyBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button AutomationProperties.Name="GitHubリポジトリを開く"
                            Click="OnOpenGitHubClick"
                            Style="{StaticResource HeaderIconButtonStyle}"
                            ToolTip="GitHubリポジトリを開きます">
                        <StackPanel>
                            <Path Width="23" Height="23" HorizontalAlignment="Center" Stretch="Uniform" Fill="White"
                                  Data="M12,2 C6.48,2 2,6.58 2,12.26 C2,16.81 4.87,20.67 8.84,22.03 C9.34,22.13 9.52,21.81 9.52,21.53 C9.52,21.29 9.51,20.5 9.5,19.69 C6.73,20.31 6.14,18.5 6.14,18.5 C5.68,17.31 5,16.99 5,16.99 C4.07,16.34 5.07,16.35 5.07,16.35 C6.1,16.43 6.64,17.44 6.64,17.44 C7.55,19.05 9.03,18.59 9.61,18.32 C9.7,17.64 9.97,17.17 10.26,16.9 C8.05,16.64 5.73,15.77 5.73,11.84 C5.73,10.72 6.12,9.81 6.77,9.1 C6.67,8.84 6.32,7.79 6.87,6.4 C6.87,6.4 7.72,6.12 9.62,7.45 C10.42,7.22 11.27,7.1 12.12,7.1 C12.97,7.1 13.82,7.22 14.62,7.45 C16.52,6.12 17.37,6.4 17.37,6.4 C17.92,7.79 17.57,8.84 17.47,9.1 C18.12,9.81 18.51,10.72 18.51,11.84 C18.51,15.78 16.18,16.63 13.96,16.89 C14.32,17.21 14.64,17.83 14.64,18.79 C14.64,20.16 14.63,21.26 14.63,21.53 C14.63,21.81 14.81,22.14 15.32,22.03 C19.28,20.66 22.14,16.81 22.14,12.26 C22.14,6.58 17.66,2 12,2 Z" />
                            <TextBlock Margin="0,3,0,0" HorizontalAlignment="Center" FontSize="10" Foreground="White" Text="GitHub" />
                        </StackPanel>
                    </Button>
                    <Button AutomationProperties.Name="ログ再現ツールを開く"
                            Click="OnOpenAssistantToolClick"
                            Style="{StaticResource HeaderIconButtonStyle}"
                            ToolTip="ログ再現ツールを開きます">
                        <StackPanel>
                            <Path Width="23" Height="23" HorizontalAlignment="Center" Stretch="Uniform"
                                  Fill="Transparent" Stroke="White" StrokeThickness="1.6"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                  Data="M3,4 L21,4 L21,20 L3,20 Z M3,8 L21,8 M6,6 L7,6 M9,6 L10,6" />
                            <TextBlock Margin="0,3,0,0" HorizontalAlignment="Center" FontSize="10" Foreground="White" Text="ログ再現" />
                        </StackPanel>
                    </Button>
                    <Button AutomationProperties.Name="READMEを表示"
                            Click="OnOpenReadmeClick"
                            Style="{StaticResource HeaderIconButtonStyle}"
                            ToolTip="READMEを開きます">
                        <StackPanel>
                            <Path Width="23" Height="23" HorizontalAlignment="Center" Stretch="Uniform"
                                  Fill="Transparent" Stroke="White" StrokeThickness="1.6"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                  Data="M12,6 C10.2,4.5 7.8,3.75 5,3.75 C4.45,3.75 4,4.2 4,4.75 L4,18.5 C4,19.05 4.45,19.5 5,19.5 C7.8,19.5 10.2,20.25 12,21.75 C13.8,20.25 16.2,19.5 19,19.5 C19.55,19.5 20,19.05 20,18.5 L20,4.75 C20,4.2 19.55,3.75 19,3.75 C16.2,3.75 13.8,4.5 12,6 Z M12,6 L12,21.75" />
                            <TextBlock Margin="0,3,0,0" HorizontalAlignment="Center" FontSize="10" Foreground="White" Text="README" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Margin="4,0,20,0" VerticalAlignment="Center">
                    <TextBlock Foreground="White" FontSize="24" FontWeight="SemiBold" Text="LogRep2" />
                    <TextBlock Margin="0,3,0,0" FontSize="11"
                               Foreground="{StaticResource HeaderSubTextBrush}"
                               Text="TEMPログ収集 ／ リアルタイム分析" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== 本文 ===== -->
        <ScrollViewer Grid.Row="1" Padding="24,20" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- 稼働コントロール -->
                <TextBlock Style="{StaticResource SectionLabelStyle}" Text="稼働コントロール" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- TEMPログ収集 -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <Border Style="{StaticResource CardHeaderBorderStyle}">
                                <DockPanel LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource CardTitleStyle}" Text="TEMPログ収集" />
                                    <!-- StatusBackground / StatusForeground / StatusText は既存 VM のまま -->
                                    <Border DockPanel.Dock="Right"
                                            Style="{StaticResource StatusPillBorderStyle}"
                                            Background="{Binding StatusBackground}"
                                            BorderBrush="{Binding StatusBorder}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center"
                                                     Fill="{Binding StatusDot}" />
                                            <TextBlock FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{Binding StatusForeground}"
                                                       Text="{Binding StatusText}" />
                                        </StackPanel>
                                    </Border>
                                </DockPanel>
                            </Border>
                            <Grid Margin="14,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource RunControlPrimaryButtonStyle}"
                                        Command="{Binding StartCommand}" Content="収集開始" />
                                <Button Grid.Column="2" Style="{StaticResource RunControlPrimaryButtonStyle}"
                                        Command="{Binding StopCommand}" Content="収集停止" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- リアルタイム分析 -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <Border Style="{StaticResource CardHeaderBorderStyle}">
                                <DockPanel LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource CardTitleStyle}" Text="リアルタイム分析" />
                                    <Border DockPanel.Dock="Right"
                                            Style="{StaticResource StatusPillBorderStyle}"
                                            Background="{Binding RealtimeStateBackground}"
                                            BorderBrush="{Binding RealtimeStateBorder}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center"
                                                     Fill="{Binding RealtimeStateDot}" />
                                            <TextBlock FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{Binding RealtimeStateForeground}"
                                                       Text="{Binding RealtimeStateText}" />
                                        </StackPanel>
                                    </Border>
                                </DockPanel>
                            </Border>
                            <StackPanel Margin="14,13">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource RunControlPrimaryButtonStyle}"
                                            Command="{Binding StartRealtimeAnalysisCommand}" Content="分析開始" />
                                    <Button Grid.Column="2" Style="{StaticResource RunControlPrimaryButtonStyle}"
                                            Command="{Binding StopRealtimeAnalysisCommand}" Content="分析停止" />
                                    <Button Grid.Column="4" Style="{StaticResource SecondaryButtonStyle}" Height="34"
                                            Command="{Binding ResetRealtimeAnalysisCommand}" Content="リセット" />
                                </Grid>

                                <!-- 警告（既存） -->
                                <Border Margin="0,10,0,0" Padding="10,7" CornerRadius="5"
                                        Background="{StaticResource WarningSoftBrush}"
                                        BorderBrush="{StaticResource WarningBorderBrush}"
                                        BorderThickness="1"
                                        Visibility="{Binding ShowRealtimeWarning, Converter={StaticResource BooleanToVisibility}}">
                                    <TextBlock Foreground="{StaticResource WarningBrush}"
                                               Text="{Binding RealtimeWarningText}" TextWrapping="Wrap" />
                                </Border>

                                <Border Margin="0,11,0,0" Padding="0,10,0,0"
                                        BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource SmallButtonStyle}" Height="28"
                                                Command="{Binding ToggleOverlayCommand}" Content="{Binding OverlayButtonText}" />
                                        <TextBlock Margin="0,0,8,0" FontWeight="SemiBold" FontSize="12"
                                                   Foreground="#FF344054" Text="オーバーレイ" />
                                        <TextBlock FontSize="11" Foreground="{StaticResource SuccessBrush}"
                                                   Text="{Binding OverlayStateText}" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- フォルダー -->
                <TextBlock Style="{StaticResource SectionLabelStyle}" Margin="0,16,0,10" Text="フォルダー" />
                <Border Style="{StaticResource CardBorderStyle}" Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="118" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="TEMPフォルダー" />
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,10,0"
                                 Style="{StaticResource PathTextBoxStyle}"
                                 Text="{Binding TempDirectory, Mode=OneWay}"
                                 ToolTip="{Binding TempDirectory}" />
                        <Button Grid.Row="0" Grid.Column="2" Margin="0,0,6,0" Height="30"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding OpenTempCommand}" Content="開く" />
                        <Button Grid.Row="0" Grid.Column="3" Height="30"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ChangeTempDirectoryCommand}" Content="変更..." />

                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="出力先フォルダー" />
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,10,0"
                                 Style="{StaticResource PathTextBoxStyle}"
                                 Text="{Binding OutputDirectory, Mode=OneWay}"
                                 ToolTip="{Binding OutputDirectory}" />
                        <Button Grid.Row="2" Grid.Column="2" Margin="0,0,6,0" Height="30"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding OpenOutputCommand}" Content="開く" />
                        <Button Grid.Row="2" Grid.Column="3" Height="30"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ChangeOutputDirectoryCommand}" Content="変更..." />
                    </Grid>
                </Border>

                <!-- 状況（左: 収集状況 / 右: リアルタイム分析の状況） -->
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 収集状況 -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,8" Text="収集状況" />
                        <Border Style="{StaticResource CardBorderStyle}" Padding="14,2,14,6">
                            <StackPanel>
                                <Border Style="{StaticResource RowDividerBorderStyle}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource FieldLabelStyle}" Text="セッションID" />
                                        <TextBlock Style="{StaticResource ValueTextStyle}" Text="{Binding SessionId}" />
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource RowDividerBorderStyle}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource FieldLabelStyle}" Text="最終検出時刻" />
                                        <TextBlock Style="{StaticResource ValueTextStyle}" Text="{Binding LastSeenAt}" />
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource RowDividerBorderStyle}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource FieldLabelStyle}" Text="元ログ保存件数" />
                                        <TextBlock Style="{StaticResource ValueTextStyle}" Text="{Binding RawRecordsWritten}" />
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource RowDividerBorderStyle}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource FieldLabelStyle}" Text="正規化ログ保存件数" />
                                        <TextBlock Style="{StaticResource ValueTextStyle}" Text="{Binding CanonicalRecordsWritten}" />
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource RowDividerBorderStyle}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource FieldLabelStyle}" Text="警告数" />
                                        <TextBlock Style="{StaticResource ValueTextStyle}" Foreground="{StaticResource WarningBrush}" Text="{Binding WarningCount}" />
                                    </DockPanel>
                                </Border>
                                <DockPanel Margin="0,6">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource FieldLabelStyle}" Text="直近エラー" />
                                    <TextBlock Style="{StaticResource ValueTextStyle}" FontWeight="Normal"
                                               Foreground="{StaticResource DangerBrush}"
                                               Text="{Binding LastError}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding LastError}" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- リアルタイム分析の状況 -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,8" Text="リアルタイム分析の状況" />
                        <Border Style="{StaticResource CardBorderStyle}" Padding="14,2,14,6">
                            <StackPanel>
                                <!-- PTメンバー行 -->
                                <Border Padding="0,8" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource SmallButtonStyle}"
                                                Command="{Binding PartyMemberSettingsCommand}" Content="設定..." />
                                        <TextBlock Margin="0,0,8,0" Style="{StaticResource FieldLabelStyle}" Text="PTメンバー" />
                                        <TextBlock Style="{StaticResource CaptionTextStyle}"
                                                   Foreground="{Binding PartyMemberSummaryForeground}"
                                                   Text="{Binding PartyMemberSummary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding PartyMemberSummary}" />
                                    </DockPanel>
                                </Border>
                                <!-- 未設定警告（既存） -->
                                <Border Margin="0,8,0,0" Padding="10,7" CornerRadius="5"
                                        Background="{StaticResource WarningSoftBrush}"
                                        BorderBrush="{StaticResource WarningBorderBrush}"
                                        BorderThickness="1"
                                        Visibility="{Binding ShowPartyMemberWarning, Converter={StaticResource BooleanToVisibility}}">
                                    <TextBlock Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"
                                               Text="PTメンバーが未設定のため、オーバーレイに個人別結果は表示されません。「設定...」から登録してください。" />
                                </Border>
                                <Border Style="{StaticResource RowDividerBorderStyle}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource FieldLabelStyle}" Text="対象件数" />
                                        <TextBlock Style="{StaticResource ValueTextStyle}" Text="{Binding RealtimeTargetCount}" />
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource RowDividerBorderStyle}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource FieldLabelStyle}" Text="正規化ログ総件数" />
                                        <TextBlock Style="{StaticResource ValueTextStyle}" Text="{Binding RealtimeCanonicalCount}" />
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource RowDividerBorderStyle}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource FieldLabelStyle}" Text="合計ダメージ" />
                                        <TextBlock Style="{StaticResource ValueTextStyle}" Text="{Binding RealtimeTotalDamage}" />
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource RowDividerBorderStyle}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource FieldLabelStyle}" Text="合計DPS" />
                                        <TextBlock Style="{StaticResource ValueTextStyle}" Text="{Binding RealtimeDps}" />
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource RowDividerBorderStyle}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource FieldLabelStyle}" Text="再集計時間" />
                                        <TextBlock Style="{StaticResource ValueTextStyle}" Text="{Binding RealtimeAggregationTime}" />
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource RowDividerBorderStyle}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource FieldLabelStyle}" Text="プロセスメモリ" />
                                        <TextBlock Style="{StaticResource ValueTextStyle}" Text="{Binding RealtimeMemory}" />
                                    </DockPanel>
                                </Border>
                                <DockPanel Margin="0,6">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource FieldLabelStyle}" Text="破棄・取消 ／ 最終更新" />
                                    <TextBlock Style="{StaticResource ValueTextStyle}">
                                        <Run Text="{Binding RealtimeDiscardedCount, Mode=OneWay}" />
                                        <Run Text=" ／ " />
                                        <Run Text="{Binding RealtimeLastUpdated, Mode=OneWay}" />
                                    </TextBlock>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== フッター（既存踏襲） ===== -->
        <Border Grid.Row="2" Padding="20,12" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushFooter}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Margin="0,0,8,0" Command="{Binding AnalysisCommand}" Content="過去ログ分析"
                            Style="{StaticResource FooterPrimaryButtonStyle}" />
                    <Button Command="{Binding SettingsCommand}" Content="設定"
                            Style="{StaticResource FooterSecondaryButtonStyle}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Margin="16,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}"
                           Text="{Binding VersionText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding VersionText}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Width="96" Margin="0,0,8,0" Command="{Binding OpenDiagnosticLogsCommand}" Content="診断ログ"
                            Style="{StaticResource FooterGhostButtonStyle}" />
                    <Button Width="136" Margin="0,0,8,0" Command="{Binding MinimizeCommand}" Content="タスクトレイへ格納"
                            Style="{StaticResource FooterGhostButtonStyle}" />
                    <Button Command="{Binding ExitCommand}" Content="終了"
                            Style="{StaticResource FooterDangerButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
