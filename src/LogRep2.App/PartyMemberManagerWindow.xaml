<!--
  PTメンバー設定。左＝登録メンバー（人数上限を ProgressBar で可視化）、
  右＝ログから検出したPC候補（出現数を併記）、中央に移送ボタン。
-->
<Window x:Class="FfxiTempLogCollector.App.PartyMemberManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FfxiTempLogCollector.App"
        Title="PTメンバー設定"
        Width="720"
        Height="500"
        MinWidth="620"
        MinHeight="420"
        FontFamily="{StaticResource UiFontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <local:OneBasedIndexConverter x:Key="OneBasedIndex" />
    </Window.Resources>
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="18,16,18,0" Orientation="Horizontal">
            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="PTメンバー" />
            <TextBlock Margin="10,0,0,0" Style="{StaticResource FieldLabelStyle}"
                       Text="オーバーレイに個人別のDPS・命中率を出す対象です。" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="18,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="52" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 登録メンバー -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeaderBorderStyle}" Padding="13,10">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButtonStyle}"
                                        Command="{Binding ClearCommand}" Content="全解除" />
                                <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="登録メンバー" />
                                <TextBlock Margin="8,0,0,0" Style="{StaticResource CaptionTextStyle}"
                                           Typography.NumeralAlignment="Tabular"
                                           Text="{Binding CountText}" />
                            </DockPanel>
                            <!-- 人数上限の可視化 -->
                            <ProgressBar Height="4" Margin="0,8,0,0"
                                         Minimum="0"
                                         Maximum="{Binding MemberCapacity}"
                                         Value="{Binding MemberCount, Mode=OneWay}"
                                         Background="{StaticResource StepInactiveBrush}"
                                         Foreground="{StaticResource SuccessDotBrush}"
                                         BorderThickness="0" />
                            <DockPanel Margin="0,9,0,0">
                                <Button DockPanel.Dock="Right" Width="56" Height="30" Margin="6,0,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding AddNameCommand}" Content="追加" />
                                <TextBox Height="30" Style="{StaticResource AppTextBoxStyle}"
                                         Text="{Binding NameInput, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border DockPanel.Dock="Bottom" Padding="13,9"
                            BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallButtonStyle}"
                                    Foreground="{StaticResource DangerBrush}" Tag="#FEF3F2" BorderBrush="Transparent"
                                    Command="{Binding RemoveCommand}" Content="削除" />
                            <StackPanel Orientation="Horizontal">
                                <Button Margin="0,0,6,0" Style="{StaticResource SmallButtonStyle}"
                                        Command="{Binding MoveUpCommand}" Content="上へ" />
                                <Button Style="{StaticResource SmallButtonStyle}"
                                        Command="{Binding MoveDownCommand}" Content="下へ" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <ListBox Style="{StaticResource AppListBoxStyle}"
                             ItemContainerStyle="{StaticResource AppListBoxItemStyle}"
                             ItemsSource="{Binding Members}"
                             SelectedItem="{Binding SelectedMember}"
                             AlternationCount="99">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <!-- 並び順番号（AlternationIndex を利用） -->
                                    <TextBlock DockPanel.Dock="Left" Width="18" Margin="0,0,9,0"
                                               FontSize="11" Typography.NumeralAlignment="Tabular"
                                               Foreground="{StaticResource TextFaintBrush}"
                                               Text="{Binding (ItemsControl.AlternationIndex),
                                                              RelativeSource={RelativeSource AncestorType=ListBoxItem},
                                                              Converter={StaticResource OneBasedIndex}}" />
                                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                                               Text="{Binding}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 移送ボタン -->
            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Width="34" Height="30" Margin="0,0,0,8"
                        Style="{StaticResource SecondaryButtonStyle}" Padding="0"
                        Command="{Binding AddCandidateCommand}" Content="←"
                        ToolTip="選択した候補を登録メンバーに追加" />
                <Button Width="34" Height="30"
                        Style="{StaticResource SecondaryButtonStyle}" Padding="0"
                        Command="{Binding RemoveCommand}" Content="→"
                        ToolTip="選択中の登録メンバーを外す" />
            </StackPanel>

            <!-- PC候補 -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeaderBorderStyle}" Padding="13,10">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="ログから検出したPC候補" />
                            <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="ログに登場したPC候補です。PT所属を確認して追加してください。" />
                        </StackPanel>
                    </Border>
                    <ListBox Style="{StaticResource AppListBoxStyle}"
                             ItemContainerStyle="{StaticResource AppListBoxItemStyle}"
                             ItemsSource="{Binding Candidates}"
                             SelectedItem="{Binding SelectedCandidate}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" FontSize="11"
                                               Typography.NumeralAlignment="Tabular"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="{Binding OccurrenceText}" />
                                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                                               Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Padding="18,12" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushFooter}" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextStyle}" Text="変更は即時保存されます。" />
                <Button HorizontalAlignment="Right" Width="96" Height="34"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsCancel="True" Content="閉じる" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
