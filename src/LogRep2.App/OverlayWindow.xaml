<!--
  オーバーレイ（高視認）。数値は等幅・太字、DPS降順で、行背景に相対量バー（DpsRatio）。
  全テキストに黒のドロップシャドウ。上部バーがドラッグ領域。
-->
<Window x:Class="FfxiTempLogCollector.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LogRep2 オーバーレイ"
        Width="460"
        Height="320"
        MinWidth="300"
        MinHeight="180"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        FontFamily="{StaticResource UiFontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Opacity="{Binding OverlayOpacity}"
        Topmost="{Binding Topmost}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

        <DropShadowEffect x:Key="OverlayTextShadow" BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.9" Color="Black" />

        <SolidColorBrush x:Key="OverlaySurfaceBrush" Color="#DB0F161F" />
        <SolidColorBrush x:Key="OverlayBorderBrush" Color="#599BB0C2" />
        <SolidColorBrush x:Key="OverlayTextBrush" Color="#FFE6EDF3" />
        <SolidColorBrush x:Key="OverlayMutedBrush" Color="#FF7D93A6" />
        <SolidColorBrush x:Key="OverlaySubBrush" Color="#FFC6D3DE" />
        <SolidColorBrush x:Key="OverlayAccentBrush" Color="#FF32D583" />

        <!-- 行背景の相対量バー（ProgressBar を平坦化して使用） -->
        <Style x:Key="OverlayBarStyle" TargetType="{x:Type ProgressBar}">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Grid>
                            <Rectangle x:Name="PART_Track" Fill="Transparent" />
                            <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="#3832D583" />
                                        <GradientStop Offset="1" Color="#0032D583" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- オーバーレイ上の小さな操作ボタン -->
        <Style x:Key="OverlayIconButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Foreground" Value="#FFB8C7D5" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="#2EFFFFFF" BorderThickness="1" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="DragSurface"
            Background="{StaticResource OverlaySurfaceBrush}"
            BorderBrush="{StaticResource OverlayBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            MouseLeftButtonDown="OnDragSurfaceMouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ヘッダー（ドラッグ領域） -->
            <Border Grid.Row="0" Padding="12,8" Background="#0DFFFFFF"
                    BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Cursor="Arrow" Orientation="Horizontal">
                        <Button x:Name="PartyMemberSettingsButton"
                                Style="{StaticResource OverlayIconButtonStyle}"
                                Command="{Binding OpenPartyMemberSettingsCommand}"
                                AutomationProperties.Name="PTメンバー設定を開く"
                                Content="⚙" ToolTip="PTメンバー設定を開く" />
                        <Button Style="{StaticResource OverlayIconButtonStyle}"
                                Command="{Binding HideCommand}"
                                Content="✕" ToolTip="オーバーレイを隠す" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Margin="0,0,8,0" Fill="{StaticResource OverlayAccentBrush}" />
                        <TextBlock FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource OverlayTextBrush}"
                                   Effect="{StaticResource OverlayTextShadow}" Text="LogRep2" />
                        <TextBlock Margin="8,0,0,0" FontFamily="{StaticResource MonoFontFamily}" FontSize="11"
                                   Foreground="{StaticResource OverlayMutedBrush}"
                                   Effect="{StaticResource OverlayTextShadow}"
                                   Text="{Binding LastUpdated}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 一覧 -->
            <Grid Grid.Row="1" Margin="0,4"
                  Visibility="{Binding HasPartyMembers, Converter={StaticResource BooleanToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="12,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="74" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource OverlayMutedBrush}" Text="メンバー" />
                    <TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold" TextAlignment="Right"
                               Foreground="{StaticResource OverlayMutedBrush}" Text="DPS" />
                    <TextBlock Grid.Column="2" FontSize="11" FontWeight="SemiBold" TextAlignment="Right"
                               Foreground="{StaticResource OverlayMutedBrush}" Text="命中率" />
                </Grid>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding PartyMembers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <!-- 最大DPSを1とした相対量バー -->
                                <ProgressBar Style="{StaticResource OverlayBarStyle}" Value="{Binding DpsRatio, Mode=OneWay}" />
                                <Grid Margin="12,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="74" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Foreground="White" FontWeight="SemiBold"
                                               FontSize="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Effect="{StaticResource OverlayTextShadow}"
                                               Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Foreground="White" TextAlignment="Right"
                                               FontFamily="{StaticResource MonoFontFamily}" FontWeight="Bold"
                                               Typography.NumeralAlignment="Tabular"
                                               FontSize="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Effect="{StaticResource OverlayTextShadow}"
                                               Text="{Binding Dps}" />
                                    <TextBlock Grid.Column="2" TextAlignment="Right"
                                               Foreground="{StaticResource OverlaySubBrush}"
                                               FontFamily="{StaticResource MonoFontFamily}" FontWeight="SemiBold"
                                               Typography.NumeralAlignment="Tabular"
                                               Effect="{StaticResource OverlayTextShadow}"
                                               Text="{Binding HitRate}" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 合計行 -->
                <Border Grid.Row="2" Margin="0,2,0,0" Padding="12,8"
                        BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="74" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource OverlayMutedBrush}"
                                   Effect="{StaticResource OverlayTextShadow}" Text="合計" />
                        <TextBlock Grid.Column="1" TextAlignment="Right" FontSize="15" FontWeight="Bold"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   Typography.NumeralAlignment="Tabular"
                                   Foreground="{StaticResource OverlayAccentBrush}"
                                   Effect="{StaticResource OverlayTextShadow}" Text="{Binding TotalDps}" />
                        <TextBlock Grid.Column="2" TextAlignment="Right" FontSize="12" FontWeight="SemiBold"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   Typography.NumeralAlignment="Tabular"
                                   Foreground="{StaticResource OverlayMutedBrush}"
                                   Effect="{StaticResource OverlayTextShadow}" Text="{Binding TotalHitRate}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- 未設定時（既存の空状態を踏襲） -->
            <Border Grid.Row="1" Margin="12" Padding="18" CornerRadius="6" Background="#802A3542"
                    Visibility="{Binding ShowEmptyPartyState, Converter={StaticResource BooleanToVisibility}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Arrow">
                    <TextBlock HorizontalAlignment="Center" Foreground="#FFFFD166" FontWeight="SemiBold"
                               FontSize="{Binding FontSize}"
                               Effect="{StaticResource OverlayTextShadow}"
                               Text="PTメンバーが設定されていません" />
                    <TextBlock Margin="0,8,0,12" HorizontalAlignment="Center" Foreground="White"
                               TextAlignment="Center" TextWrapping="Wrap"
                               Effect="{StaticResource OverlayTextShadow}"
                               Text="DPS／通常命中率を表示するには、PTメンバーを登録してください。" />
                    <Button Width="176" Height="32" HorizontalAlignment="Center"
                            Style="{StaticResource OverlayIconButtonStyle}"
                            Command="{Binding OpenPartyMemberSettingsCommand}"
                            Content="PTメンバー設定を開く" />
                </StackPanel>
            </Border>

            <!-- 調整バー -->
            <Border Grid.Row="2" Padding="12,8" Background="#0AFFFFFF"
                    BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0" CornerRadius="0,0,8,8">
                <StackPanel Cursor="Arrow" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" FontSize="11"
                               Foreground="{StaticResource OverlayMutedBrush}" Text="透明度" />
                    <Slider Width="74" Margin="8,0,0,0" VerticalAlignment="Center"
                            Minimum="0.25" Maximum="1" Value="{Binding OverlayOpacity}" />
                    <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="11"
                               Foreground="{StaticResource OverlayMutedBrush}" Text="文字" />
                    <Slider Width="64" Margin="8,0,0,0" VerticalAlignment="Center"
                            Minimum="10" Maximum="40" Value="{Binding FontSize}" />
                    <CheckBox Margin="16,0,0,0" VerticalAlignment="Center" FontSize="11"
                              Foreground="{StaticResource OverlayTextBrush}"
                              IsChecked="{Binding Topmost}" Content="最前面" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
