<!--
  設定画面。左のカテゴリ ListBox の SelectedIndex を、ヘッダー非表示の TabControl に
  バインドしてパネルを切り替える。各設定は「タイトル＋補足＋コントロール」の行で統一。
-->
<Window x:Class="FfxiTempLogCollector.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定"
        Height="650"
        Width="760"
        MinHeight="560"
        MinWidth="680"
        FontFamily="{StaticResource UiFontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <!-- カテゴリ項目 -->
        <Style x:Key="CategoryItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="11,9" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#FF344054" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimarySoftBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryHoverBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 1 設定 = タイトル + 補足 + コントロール の行 -->
        <Style x:Key="SettingRowBorderStyle" TargetType="{x:Type Border}">
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="15,13" />
        </Style>
        <Style x:Key="SettingTitleStyle" BasedOn="{StaticResource CardHeaderTextStyle}" TargetType="{x:Type TextBlock}" />
        <Style x:Key="SettingHintStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="176" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- カテゴリ -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushDefault}" BorderThickness="0,0,1,0">
            <ListBox x:Name="CategoryList"
                     Margin="10,14"
                     Background="Transparent"
                     BorderThickness="0"
                     SelectedIndex="0"
                     ItemContainerStyle="{StaticResource CategoryItemStyle}">
                <ListBoxItem Content="フォルダー" />
                <ListBoxItem Content="収集" />
                <ListBoxItem Content="リアルタイム分析" />
                <ListBoxItem Content="起動とウィンドウ" />
                <ListBoxItem Content="診断とログ" />
            </ListBox>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TabControl Grid.Row="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        SelectedIndex="{Binding SelectedIndex, ElementName=CategoryList}">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="{x:Type TabItem}">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                </TabControl.ItemContainerStyle>

                <!-- ===== フォルダー ===== -->
                <TabItem>
                    <ScrollViewer Padding="22,20" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="フォルダー" />
                            <TextBlock Style="{StaticResource SettingHintStyle}" Text="収集対象のTEMPフォルダーと、セッションの出力先を指定します。" />
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,14,0,0">
                                <StackPanel>
                                    <Border Style="{StaticResource SettingRowBorderStyle}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SettingTitleStyle}" Text="TEMPフォルダー" />
                                            <TextBlock Style="{StaticResource SettingHintStyle}" Text="FFXI がログを書き出すフォルダー。通常は自動検出されます。" />
                                            <DockPanel Margin="0,9,0,0">
                                                <Button DockPanel.Dock="Right" Width="76" Height="32" Margin="8,0,0,0"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding SelectTempDirectoryCommand}" Content="参照..." />
                                                <TextBox x:Name="TempDirectoryTextBox" Height="32"
                                                         Style="{StaticResource AppTextBoxStyle}"
                                                         FontFamily="{StaticResource MonoFontFamily}"
                                                         Text="{Binding TempDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SettingRowBorderStyle}" BorderThickness="0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SettingTitleStyle}" Text="出力先フォルダー" />
                                            <TextBlock Style="{StaticResource SettingHintStyle}" Text="セッションごとに raw / canonical の JSONL を保存します。" />
                                            <DockPanel Margin="0,9,0,0">
                                                <Button DockPanel.Dock="Right" Width="76" Height="32" Margin="8,0,0,0"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding SelectOutputDirectoryCommand}" Content="参照..." />
                                                <TextBox x:Name="OutputDirectoryTextBox" Height="32"
                                                         Style="{StaticResource AppTextBoxStyle}"
                                                         FontFamily="{StaticResource MonoFontFamily}"
                                                         Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== 収集 ===== -->
                <TabItem>
                    <ScrollViewer Padding="22,20" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="収集" />
                            <TextBlock Style="{StaticResource SettingHintStyle}" Text="TEMPログの監視間隔と、書き出すログの種類を設定します。" />
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,14,0,0">
                                <StackPanel>
                                    <Border Style="{StaticResource SettingRowBorderStyle}">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <TextBox Width="88" Style="{StaticResource AppTextBoxStyle}"
                                                         TextAlignment="Right"
                                                         Text="{Binding PollingIntervalText, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Margin="6,0,0,0" Style="{StaticResource FieldLabelStyle}" Text="ms" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SettingTitleStyle}" Text="ポーリング間隔" />
                                                <TextBlock Style="{StaticResource SettingHintStyle}" Text="短くすると検出が速くなりますが CPU 使用が増えます。" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource SettingRowBorderStyle}">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <CheckBox Margin="0,0,14,0" Style="{StaticResource AppCheckBoxStyle}"
                                                          IsChecked="{Binding WatchWindow1}" Content="ウィンドウ1" />
                                                <CheckBox Margin="0" Style="{StaticResource AppCheckBoxStyle}"
                                                          IsChecked="{Binding WatchWindow2}" Content="ウィンドウ2" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SettingTitleStyle}" Text="監視対象のログウィンドウ" />
                                                <TextBlock Style="{StaticResource SettingHintStyle}" Text="ゲーム側のログウィンドウ設定に合わせて選びます。" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource SettingRowBorderStyle}">
                                        <DockPanel>
                                            <TextBox DockPanel.Dock="Right" Width="160" Margin="12,0,0,0" VerticalAlignment="Center"
                                                     Style="{StaticResource AppTextBoxStyle}"
                                                     Text="{Binding MarkerPrefix, UpdateSourceTrigger=PropertyChanged}" />
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SettingTitleStyle}" Text="マーカー文字列" />
                                                <TextBlock Style="{StaticResource SettingHintStyle}" Text="この文字列で始まる発言を分析区間のマーカーとして扱います。" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource SettingRowBorderStyle}" BorderThickness="0">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <CheckBox Margin="0,0,14,0" Style="{StaticResource AppCheckBoxStyle}"
                                                          IsChecked="{Binding RawOutput}" Content="raw" />
                                                <CheckBox Margin="0" Style="{StaticResource AppCheckBoxStyle}"
                                                          IsChecked="{Binding CanonicalOutput}" Content="canonical" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SettingTitleStyle}" Text="出力の種類" />
                                                <TextBlock Style="{StaticResource SettingHintStyle}" Text="raw は原文、canonical は正規化済みのレコードです。" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== リアルタイム分析 ===== -->
                <TabItem>
                    <ScrollViewer Padding="22,20" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="リアルタイム分析" />
                            <TextBlock Style="{StaticResource SettingHintStyle}" Text="分析中のオーバーレイ表示に関する設定です。" />
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,14,0,0">
                                <Border Style="{StaticResource SettingRowBorderStyle}" BorderThickness="0">
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center"
                                                  Style="{StaticResource AppCheckBoxStyle}"
                                                  IsChecked="{Binding ShowOverlayOnRealtimeAnalysisStart}" Content="" />
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SettingTitleStyle}" Text="分析開始時にオーバーレイを表示する" />
                                            <TextBlock Style="{StaticResource SettingHintStyle}" Text="オフの場合はメイン画面の「オーバーレイ」から手動で表示します。" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== 起動とウィンドウ ===== -->
                <TabItem>
                    <ScrollViewer Padding="22,20" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="起動とウィンドウ" />
                            <TextBlock Style="{StaticResource SettingHintStyle}" Text="アプリの起動時動作と、閉じる／最小化したときの挙動です。" />
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,14,0,0">
                                <StackPanel>
                                    <Border Style="{StaticResource SettingRowBorderStyle}">
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center"
                                                      Style="{StaticResource AppCheckBoxStyle}"
                                                      IsChecked="{Binding AutoStartCollectionOnLaunch}" Content="" />
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SettingTitleStyle}" Text="起動時に自動で収集開始する" />
                                                <TextBlock Style="{StaticResource SettingHintStyle}" Text="ゲーム起動と同時に立ち上げる運用向けです。" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource SettingRowBorderStyle}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SettingTitleStyle}" Text="タスクトレイ" />
                                            <TextBlock Style="{StaticResource SettingHintStyle}" Text="常駐時の格納タイミングと通知の有無です。" />
                                            <StackPanel Margin="0,9,0,0">
                                                <CheckBox Style="{StaticResource AppCheckBoxStyle}" IsChecked="{Binding MinimizeToTrayWhileCollecting}" Content="収集開始後にタスクトレイへ格納する" />
                                                <CheckBox Style="{StaticResource AppCheckBoxStyle}" IsChecked="{Binding MinimizeToTray}" Content="最小化操作でタスクトレイへ格納する" />
                                                <CheckBox Style="{StaticResource AppCheckBoxStyle}" Margin="0" IsChecked="{Binding ShowTrayNotifications}" Content="タスクトレイ通知を表示する" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SettingRowBorderStyle}">
                                        <DockPanel>
                                            <ComboBox DockPanel.Dock="Right" Width="230" Margin="12,0,0,0" VerticalAlignment="Center"
                                                      Style="{StaticResource AppComboBoxStyle}"
                                                      SelectedValue="{Binding CloseButtonBehavior}" SelectedValuePath="Tag">
                                                <ComboBoxItem Tag="confirm_exit" Content="終了確認を表示する" />
                                                <ComboBoxItem Tag="tray_when_collecting" Content="収集中のみ格納する" />
                                                <ComboBoxItem Tag="always_tray" Content="常に格納する" />
                                            </ComboBox>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SettingTitleStyle}" Text="閉じるボタン押下時" />
                                                <TextBlock Style="{StaticResource SettingHintStyle}" Text="収集中に誤って終了しないよう既定は確認を表示します。" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource SettingRowBorderStyle}" BorderThickness="0">
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center"
                                                      Style="{StaticResource AppCheckBoxStyle}"
                                                      IsChecked="{Binding CheckForUpdatesOnLaunch}" Content="" />
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SettingTitleStyle}" Text="起動時に新しいバージョンを確認する" />
                                                <TextBlock Style="{StaticResource SettingHintStyle}" Text="GitHub のリリース情報を参照します。" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== 診断とログ ===== -->
                <TabItem>
                    <ScrollViewer Padding="22,20" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="診断とログ" />
                            <TextBlock Style="{StaticResource SettingHintStyle}" Text="アプリ自身の動作ログの詳細度です。" />
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,14,0,0">
                                <Border Style="{StaticResource SettingRowBorderStyle}" BorderThickness="0">
                                    <DockPanel>
                                        <ComboBox DockPanel.Dock="Right" Width="160" Margin="12,0,0,0" VerticalAlignment="Center"
                                                  Style="{StaticResource AppComboBoxStyle}"
                                                  SelectedValue="{Binding LogLevel}" SelectedValuePath="Tag">
                                            <ComboBoxItem Tag="debug" Content="デバッグ" />
                                            <ComboBoxItem Tag="info" Content="情報" />
                                            <ComboBoxItem Tag="warning" Content="警告" />
                                            <ComboBoxItem Tag="error" Content="エラー" />
                                        </ComboBox>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SettingTitleStyle}" Text="ログレベル" />
                                            <TextBlock Style="{StaticResource SettingHintStyle}" Text="不具合報告時のみ「デバッグ」にしてください。" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- フッター -->
            <Border Grid.Row="1" Padding="20,12" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushFooter}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <!-- 未保存の変更件数 -->
                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextStyle}"
                               Text="{Binding DirtySummaryText}" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Width="96" Height="34" Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CancelCommand}" Content="キャンセル" />
                        <Button Width="96" Height="34"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding SaveCommand}" Content="保存" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
