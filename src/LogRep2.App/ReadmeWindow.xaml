<Window x:Class="FfxiTempLogCollector.App.ReadmeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LogRep2 README"
        Icon="pack://application:,,,/LogRep2;component/app.ico"
        Height="760"
        Width="960"
        MinHeight="420"
        MinWidth="640"
        WindowStartupLocation="CenterOwner">
    <Grid Background="#F4F6F8">
        <Border Margin="16"
                Background="White"
                BorderBrush="#D9DEE5"
                BorderThickness="1">
            <WebBrowser x:Name="ReadmeBrowser" />
        </Border>
    </Grid>
</Window>
