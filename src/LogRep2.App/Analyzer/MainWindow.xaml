<Window x:Class="FFXI_LogAnalyzer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FFXI_LogAnalyzer.App"
        mc:Ignorable="d"
        Icon="pack://application:,,,/LogRep2;component/app.ico"
        Title="LogRep2 - 過去ログ分析"
        Height="900" Width="1600" MinHeight="600" MinWidth="1000"
        FontFamily="{StaticResource UiFontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!--
          ステップヘッダーと本文を上下に分けた TabControl。
          ヘッダー帯は白（上のツールバーと地続き）、本文は画面背景色の上に配置する。
        -->
        <Style x:Key="AnalyzerStepTabControlStyle"
               BasedOn="{StaticResource StepTabControlStyle}"
               TargetType="{x:Type TabControl}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Padding="20,0"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrushDefault}"
                                    BorderThickness="0,0,0,1">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource FieldLabelStyle}">
                                        <Run Text="分析対象 " />
                                        <Run FontWeight="SemiBold"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             Text="{Binding AnalysisTargetSummary, Mode=OneWay}" />
                                    </TextBlock>
                                    <TabPanel IsItemsHost="True" HorizontalAlignment="Left" />
                                </DockPanel>
                            </Border>

                            <!-- 本文の余白は各ステップのビューが持つ（フッターを端まで伸ばすため） -->
                            <Border Grid.Row="1">
                                <DockPanel>
                                    <!-- 読み込み中 -->
                                    <Border DockPanel.Dock="Top"
                                            Margin="20,16,20,0"
                                            Padding="12,10"
                                            CornerRadius="6"
                                            Background="{StaticResource PrimarySoftBrush}"
                                            BorderBrush="{StaticResource PrimarySoftBorderBrush}"
                                            BorderThickness="1"
                                            Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right"
                                                    Style="{StaticResource SmallButtonStyle}"
                                                    Command="{Binding CancelLoadingCommand}"
                                                    Content="キャンセル" />
                                            <ProgressBar Width="180" Height="6" Margin="0,0,12,0"
                                                         IsIndeterminate="True"
                                                         Background="#FFDBEAFE"
                                                         Foreground="{StaticResource PrimaryBrush}"
                                                         BorderThickness="0" />
                                            <TextBlock VerticalAlignment="Center"
                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                       Text="{Binding BusyText}" />
                                        </DockPanel>
                                    </Border>
                                    <ContentPresenter ContentSource="SelectedContent" />
                                </DockPanel>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== ツールバー ===== -->
        <Border Grid.Row="0" Padding="20,12,20,10" Background="{StaticResource SurfaceBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding OpenLogExclusionsCommand}" Content="ログ確認・除外" />
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding RefreshSessionsCommand}" Content="更新" />
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding OpenSessionRootFolderCommand}" Content="出力先を開く" />
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding OpenSelectedSessionFolderCommand}" Content="選択セッションを開く" />
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding OpenGameLogCommand}"
                            Content="ゲーム内ログを表示"
                            ToolTip="選択中のセッションをAssistantToolで開きます" />
                    <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0"
                            BorderBrush="Transparent"
                            Foreground="{StaticResource DangerBrush}"
                            Tag="#FEF3F2"
                            Command="{Binding DeleteSelectedSessionCommand}" Content="削除" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Text="過去ログ分析" />
                    <TextBlock Margin="14,0,0,0" Style="{StaticResource FieldLabelStyle}" Text="出力先" />
                    <TextBlock Margin="6,0,0,0" Style="{StaticResource MonoTextStyle}"
                               MaxWidth="420" TextTrimming="CharacterEllipsis"
                               Text="{Binding SessionRootFolderPath}"
                               ToolTip="{Binding SessionRootFolderPath}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== ステップヘッダー ＋ 本文 ===== -->
        <TabControl x:Name="StepTabs"
                    Grid.Row="1"
                    Style="{StaticResource AnalyzerStepTabControlStyle}"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <TabItem Tag="{Binding SessionStepBadge}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="セッション選択" />
                        <TextBlock Margin="9,0,0,0" FontSize="11" FontWeight="Normal"
                                   Typography.NumeralAlignment="Tabular"
                                   Foreground="{StaticResource TextFaintBrush}"
                                   Text="{Binding SessionStepSummary}" />
                    </StackPanel>
                </TabItem.Header>

                <!-- ===== ① セッション選択 ===== -->
                <Grid Margin="20,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="230" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- セッション一覧 -->
                    <Border Grid.Row="0" Grid.ColumnSpan="3" Style="{StaticResource CardBorderStyle}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource CardHeaderBorderStyle}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="セッション一覧" />
                                    <TextBlock Margin="20,0,8,0" Style="{StaticResource FieldLabelStyle}"
                                               Text="一括操作" />
                                    <StackPanel x:Name="SessionBulkActionsPanel" Orientation="Horizontal">
                                        <Button Margin="0,0,6,0" Style="{StaticResource SmallButtonStyle}"
                                                Command="{Binding EnableAllSessionsCommand}"
                                                ToolTip="検索で非表示のセッションも含め、すべて分析対象にします。"
                                                Content="すべて対象にする" />
                                        <Button Style="{StaticResource SmallButtonStyle}"
                                                Command="{Binding DisableAllSessionsCommand}"
                                                ToolTip="検索で非表示のセッションも含め、すべて分析対象から外します。"
                                                Content="すべて外す" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <StackPanel DockPanel.Dock="Top" Margin="12,8">
                                <DockPanel>
                                    <TextBlock Text="エイリアス・ID検索" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox Text="{Binding SessionSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                                <TextBlock Margin="0,6,0,0" Style="{StaticResource CaptionTextStyle}" Text="{Binding SessionSearchSummary}" />
                            </StackPanel>
                            <DataGrid Style="{StaticResource AppDataGridStyle}"
                                      IsReadOnly="False"
                                      x:Name="SessionGrid" RowHeight="40"
                                      BeginningEdit="OnSessionGridBeginningEdit" CellEditEnding="OnSessionGridCellEditEnding"
                                      ItemsSource="{Binding FilteredSessions}"
                                      SelectedItem="{Binding SelectedSession, Mode=TwoWay}">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="エイリアスを編集" InputGestureText="F2" Click="OnEditAliasMenuClick"
                                                  IsEnabled="{Binding SelectedSession.CanEditAlias}" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="対象" Width="72"
                                                            Binding="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTemplateColumn Width="280"
                                                            SortMemberPath="Alias"
                                                            CellStyle="{StaticResource AliasCellStyle}">
                                        <DataGridTemplateColumn.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="エイリアス" />
                                                <Path Width="13" Height="13" Margin="6,0,0,0" VerticalAlignment="Center"
                                                      Stretch="Uniform" StrokeThickness="1.4" StrokeLineJoin="Round"
                                                      Stroke="{StaticResource TextFaintBrush}"
                                                      Data="{StaticResource PencilIconGeometry}"
                                                      ToolTip="この列はクリックまたは F2 で編集できます" />
                                            </StackPanel>
                                        </DataGridTemplateColumn.Header>

                                        <!-- 表示 -->
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource AliasDisplayBorderStyle}">
                                                        <DockPanel>
                                                            <Path DockPanel.Dock="Right" Width="13" Height="13" Margin="8,0,0,0"
                                                                  VerticalAlignment="Center" Stretch="Uniform" StrokeThickness="1.4" StrokeLineJoin="Round"
                                                                  Stroke="{StaticResource TextSecondaryBrush}" Data="{StaticResource PencilIconGeometry}"
                                                                  Style="{StaticResource AliasHoverOnlyStyle}" />
                                                            <TextBlock VerticalAlignment="Center" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}"
                                                                       Text="{Binding Alias}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Alias}" />
                                                        </DockPanel>
                                                    </Border>
                                                    <Border Grid.Column="1" Margin="8,0,0,0" Padding="7,3" CornerRadius="9" VerticalAlignment="Center"
                                                            Background="{StaticResource SuccessSoftBrush}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAliasJustSaved}" Value="True">
                                                                        <DataTrigger.EnterActions>
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                                                                    </ObjectAnimationUsingKeyFrames>
                                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0" />
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </DataTrigger.EnterActions>
                                                                        <DataTrigger.ExitActions>
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.2" />
                                                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.2" Value="{x:Static Visibility.Collapsed}" />
                                                                                    </ObjectAnimationUsingKeyFrames>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </DataTrigger.ExitActions>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" Text="✓ 保存しました" />
                                                    </Border>
                                                    <!-- ④ 未設定（ホバー・選択時のみ） -->
                                                    <Border Height="30" CornerRadius="5">

                                                        <Border.Style>
                                                            <Style TargetType="{x:Type Border}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding HasAlias}" Value="False" />
                                                                            <Condition Binding="{Binding CanEditAlias}" Value="True" />
                                                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridCell}}" Value="True" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </MultiDataTrigger>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding HasAlias}" Value="False" />
                                                                            <Condition Binding="{Binding CanEditAlias}" Value="True" />
                                                                            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Rectangle Stroke="{StaticResource BorderBrushStrong}" StrokeThickness="1"
                                                                       StrokeDashArray="3 2" RadiusX="5" RadiusY="5" />
                                                            <TextBlock Margin="8,0" VerticalAlignment="Center" FontSize="12"
                                                                       Foreground="{StaticResource TextFaintBrush}"
                                                                       Text="＋ エイリアスを追加" />
                                                        </Grid>
                                                    </Border>

                                                    <!-- ⑥ 読み込み失敗（編集不可） -->
                                                    <StackPanel Margin="4,0" Orientation="Horizontal" VerticalAlignment="Center"
                                                                ToolTip="{Binding AliasLoadError}">
                                                        <StackPanel.Style>
                                                            <Style TargetType="{x:Type StackPanel}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CanEditAlias}" Value="False">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <Path Width="12" Height="12" Margin="0,0,6,0" Stretch="Uniform"
                                                              StrokeThickness="1.4" Stroke="{StaticResource WarningBrush}"
                                                              Data="{StaticResource LockIconGeometry}" />
                                                        <TextBlock FontSize="12" Foreground="{StaticResource WarningBrush}" Text="読み込めません" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>

                                        <!-- ③ 編集中 -->
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <Popup PlacementTarget="{Binding ElementName=AliasEditFrame}" Placement="Bottom" VerticalOffset="5"
                                                           IsOpen="{Binding HasAliasEditError, Mode=OneWay}" StaysOpen="True" AllowsTransparency="True" Focusable="False">
                                                        <Border Padding="10,7" CornerRadius="5" Background="{StaticResource SurfaceBrush}"
                                                                BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" MaxWidth="420">
                                                            <TextBlock Text="{Binding AliasEditError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                                                        </Border>
                                                    </Popup>
                                                    <!-- 外側 = フォーカスリング（3px）、内側 = 2px の枠 -->
                                                    <Border CornerRadius="8" Padding="3" Margin="-3"
                                                            Background="{StaticResource FocusRingBrush}">
                                                        <Border x:Name="AliasEditFrame" Height="30" Padding="8,0" CornerRadius="5"
                                                                Background="{StaticResource SurfaceBrush}"
                                                                BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="2">
                                                            <DockPanel>
                                                                <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                           FontSize="10.5" Typography.NumeralAlignment="Tabular"
                                                                           Foreground="{StaticResource TextFaintBrush}">
                                                                    <Run Text="{Binding Text.Length, ElementName=AliasEditor, Mode=OneWay}" /><Run Text="/100" />
                                                                </TextBlock>
                                                                <TextBox x:Name="AliasEditor"
                                                                         Style="{StaticResource AliasEditTextBoxStyle}"
                                                                         Text="{Binding EditingAlias, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         Loaded="OnAliasEditorLoaded" LostKeyboardFocus="OnAliasEditorLostKeyboardFocus"
                                                                         PreviewKeyDown="OnAliasEditorPreviewKeyDown" />
                                                            </DockPanel>
                                                        </Border>
                                                    </Border>
                                                </StackPanel>
                                                <DataTemplate.Triggers>
                                                    <!-- 保存失敗時: 赤枠 ＋ エラーをツールチップで常時表示 -->
                                                    <DataTrigger Binding="{Binding HasAliasEditError}" Value="True">
                                                        <Setter TargetName="AliasEditFrame" Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                                        <Setter TargetName="AliasEditor" Property="ToolTip" Value="{Binding AliasEditError}" />
                                                        <Setter TargetName="AliasEditor" Property="ToolTipService.IsEnabled" Value="True" />
                                                        <Setter TargetName="AliasEditor" Property="ToolTipService.Placement" Value="Bottom" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="セッションID" Width="152" IsReadOnly="True" Binding="{Binding SessionId}" />
                                    <DataGridTextColumn Header="開始" Width="170" IsReadOnly="True" Binding="{Binding StartedAt}" />
                                    <DataGridTextColumn Header="終了" Width="170" IsReadOnly="True" Binding="{Binding EndedAt}" />
                                    <DataGridTextColumn Header="レコード" Width="96" IsReadOnly="True"
                                                        Binding="{Binding RecordCount, StringFormat={}{0:N0}}"
                                                        ElementStyle="{StaticResource NumericCellStyle}"
                                                        HeaderStyle="{StaticResource NumericColumnHeaderStyle}" />
                                    <DataGridTextColumn Header="マーカー" Width="96" IsReadOnly="True"
                                                        Binding="{Binding MarkerCount, StringFormat={}{0:N0}}"
                                                        ElementStyle="{StaticResource NumericCellStyle}"
                                                        HeaderStyle="{StaticResource NumericColumnHeaderStyle}" />
                                    <DataGridTextColumn Header="状態" Width="96" IsReadOnly="True" Binding="{Binding Status}" />
                                    <DataGridTextColumn Header="フォルダ" Width="*" IsReadOnly="True"
                                                        Binding="{Binding FolderPath}"
                                                        ElementStyle="{StaticResource MonoCellStyle}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <!-- セッション情報 -->
                    <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource CardHeaderBorderStyle}">
                                <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="セッション情報" />
                            </Border>
                            <DataGrid Style="{StaticResource AppDataGridStyle}" IsReadOnly="True"
                                      ItemsSource="{Binding SessionInfoRows}"
                                      Visibility="{Binding HasSession, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="項目" Width="220" Binding="{Binding Label}" />
                                    <DataGridTextColumn Header="値" Width="*" Binding="{Binding Value}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <!-- 警告 -->
                    <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource CardHeaderBorderStyle}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" CornerRadius="10" Padding="8,4"
                                            Background="{StaticResource WarningSoftBrush}"
                                            BorderBrush="{StaticResource WarningBorderBrush}" BorderThickness="1">
                                        <TextBlock FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource WarningBrush}"
                                                   Text="{Binding Warnings.Count}" />
                                    </Border>
                                    <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="警告" />
                                </DockPanel>
                            </Border>
                            <ListBox Style="{StaticResource AppListBoxStyle}"
                                     ItemContainerStyle="{StaticResource AppListBoxItemStyle}"
                                     ItemsSource="{Binding Warnings}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Margin="0,0,8,0"
                                                       VerticalAlignment="Top"
                                                       Foreground="#FFF79009" Text="●" />
                                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                                       Text="{Binding}" TextWrapping="Wrap" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Tag="{Binding RangeStepBadge}" IsEnabled="{Binding IsRangeStepEnabled}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="分析区間" />
                        <TextBlock Margin="9,0,0,0" FontSize="11" FontWeight="Normal"
                                   Foreground="{StaticResource TextFaintBrush}"
                                   Text="{Binding RangeStepSummary}" />
                    </StackPanel>
                </TabItem.Header>
                <local:AnalysisRangeSelectionView DataContext="{Binding AnalysisRange}" />
            </TabItem>

            <TabItem Tag="{Binding ResultStepBadge}" IsEnabled="{Binding IsResultStepEnabled}" Header="分析結果">
                <local:AnalysisResultView DataContext="{Binding AnalysisResult}" />
            </TabItem>
        </TabControl>

        <!-- ===== フッター（① のみ。②③ は各ビューが自前のフッターを持つ） ===== -->
        <Border Grid.Row="2" Padding="20,12" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushFooter}" BorderThickness="0,1,0,0"
                Visibility="{Binding IsSessionStepSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButtonStyle}" Width="164"
                        Command="{Binding GoToNextStepCommand}" Content="分析区間へ進む →" />
                <TextBlock Style="{StaticResource FieldLabelStyle}" TextTrimming="CharacterEllipsis"
                           Text="{Binding StatusMessage}" ToolTip="{Binding StatusMessage}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
