<Window x:Class="FFXI_LogAnalyzer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FFXI_LogAnalyzer.App"
        mc:Ignorable="d"
        Icon="pack://application:,,,/LogRep2;component/app.ico"
        Title="LogRep2 - 過去ログ分析" Height="900" Width="1600" MinHeight="520" MinWidth="760">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="120" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button Content="セッション出力先を開く" Command="{Binding OpenSessionRootFolderCommand}" />
            <Button Content="更新" Command="{Binding RefreshSessionsCommand}" />
            <Button Content="選択セッションを開く" Command="{Binding OpenSelectedSessionFolderCommand}" />
            <Button Content="削除" Command="{Binding DeleteSelectedSessionCommand}" />
        </WrapPanel>

        <Border DockPanel.Dock="Top"
                Margin="0,0,0,12"
                Padding="10"
                Background="#EFF6FF"
                BorderBrush="#60A5FA"
                BorderThickness="1"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        MinWidth="96"
                        Content="キャンセル"
                        Command="{Binding CancelLoadingCommand}" />
                <ProgressBar Width="180"
                             Height="16"
                             Margin="0,0,12,0"
                             IsIndeterminate="True" />
                <TextBlock Text="{Binding BusyText}" />
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Top" BorderBrush="#D0D7DE" BorderThickness="1" Padding="10,6" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="分析対象:" FontWeight="Bold" />
                <TextBlock Grid.Column="1" Text="{Binding AnalysisTargetSummary}" Margin="6,0,20,0" />
                <TextBlock Grid.Column="2" Text="出力先:" FontWeight="Bold" />
                <TextBlock Grid.Column="3"
                           Text="{Binding SessionRootFolderPath}"
                           ToolTip="{Binding SessionRootFolderPath}"
                           Margin="6,0,0,0"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Margin="0,8,0,0"
                Padding="8,5"
                Background="#F6F8FA"
                BorderBrush="#D0D7DE"
                BorderThickness="1">
            <TextBlock Text="{Binding StatusMessage}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding StatusMessage}" />
        </Border>

        <TabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <TabItem Header="{Binding SessionTabHeader}">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <GroupBox Header="セッション一覧" Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,0">
                        <DockPanel Margin="8">
                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Button Content="すべて分析対象にする"
                                        Command="{Binding EnableAllSessionsCommand}" />
                                <Button Content="分析対象をすべて外す"
                                        Command="{Binding DisableAllSessionsCommand}" />
                            </WrapPanel>
                            <DataGrid ItemsSource="{Binding Sessions}"
                                  SelectedItem="{Binding SelectedSession, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="False"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="分析対象" Binding="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                <DataGridTextColumn Header="セッションID" Binding="{Binding SessionId}" Width="150" IsReadOnly="True" />
                                <DataGridTextColumn Header="開始時刻" Binding="{Binding StartedAt}" Width="170" IsReadOnly="True" />
                                <DataGridTextColumn Header="終了時刻" Binding="{Binding EndedAt}" Width="170" IsReadOnly="True" />
                                <DataGridTextColumn Header="レコード数" Binding="{Binding RecordCount}" Width="100" IsReadOnly="True" />
                                <DataGridTextColumn Header="マーカー数" Binding="{Binding MarkerCount}" Width="100" IsReadOnly="True" />
                                <DataGridTextColumn Header="状態" Binding="{Binding Status}" Width="100" IsReadOnly="True" />
                                <DataGridTextColumn Header="フォルダ" Binding="{Binding FolderPath}" Width="*" IsReadOnly="True" />
                            </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </GroupBox>

                    <GroupBox Header="セッション情報" Grid.Row="2" Grid.Column="0" Margin="0,0,12,0">
                        <DataGrid ItemsSource="{Binding SessionInfoRows}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  Visibility="{Binding HasSession, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="項目" Binding="{Binding Label}" Width="220" />
                                <DataGridTextColumn Header="値" Binding="{Binding Value}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <GroupBox Header="警告" Grid.Row="2" Grid.Column="1">
                        <ListBox ItemsSource="{Binding Warnings}" />
                    </GroupBox>

                    <DockPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right"
                                Content="分析区間へ進む"
                                Command="{Binding GoToNextStepCommand}" />
                        <TextBlock Text="{Binding NextStepText}"
                                   TextWrapping="Wrap" />
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="{Binding RangeTabHeader}">
                <local:AnalysisRangeSelectionView DataContext="{Binding AnalysisRange}" Margin="0,8,0,0" />
            </TabItem>

            <TabItem Header="{Binding ResultTabHeader}">
                <local:AnalysisResultView DataContext="{Binding AnalysisResult}" Margin="0,8,0,0" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
