<Window x:Class="FFXI_LogAnalyzer.App.TimelineMemberSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PT行動レポート — メンバー選択"
        Width="560" Height="520" MinWidth="480" MinHeight="360"
        FontFamily="{StaticResource UiFontFamily}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        WindowStartupLocation="CenterOwner">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="18,16,18,0">
            <TextBlock Text="出力するPTメンバー" FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="この戦闘に参加したPCを選択してください。WS・アビリティ・魔法をHTMLに出力します。"
                       Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Margin="18,12" Style="{StaticResource CardBorderStyle}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource CardHeaderBorderStyle}" Padding="13,10">
                    <DockPanel>
                        <TextBlock x:Name="SelectionCount" DockPanel.Dock="Right"
                                   Style="{StaticResource CaptionTextStyle}" Typography.NumeralAlignment="Tabular" />
                        <TextBlock Text="PC登録・PC候補" Style="{StaticResource CardHeaderTextStyle}" />
                    </DockPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="MemberList" />
                </ScrollViewer>
            </DockPanel>
        </Border>
        <Border Grid.Row="2" Padding="18,12" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushFooter}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="1名以上選択すると保存先を指定できます。"
                           Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,10" />
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="キャンセル" IsCancel="True" Width="100" Height="34" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <Button x:Name="AcceptButton" Content="HTML出力する" IsDefault="True" IsEnabled="False"
                            MinWidth="150" Height="34" Click="OnAccept" Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
