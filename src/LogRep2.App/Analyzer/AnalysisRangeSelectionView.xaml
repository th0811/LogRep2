<!--
  ② 分析区間。モード切替を先頭のトグルに集約し、
  左＝区間一覧、右＝選択区間のサマリと先頭ログのプレビュー。進む／戻るはフッター。
-->
<UserControl x:Class="FFXI_LogAnalyzer.App.AnalysisRangeSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              mc:Ignorable="d"
              d:DesignHeight="560" d:DesignWidth="1160"
              FontFamily="{StaticResource UiFontFamily}"
              UseLayoutRounding="True"
              SnapsToDevicePixels="True"
              TextOptions.TextFormattingMode="Display"
              TextOptions.TextRenderingMode="ClearType">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- モード切替トグル -->
        <Style x:Key="ModeRadioStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#FF344054" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="Bd" Height="32" Padding="13,0" CornerRadius="6"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrushStrong}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="Dot" Width="11" Height="11" Margin="0,0,7,0"
                                         Stroke="{StaticResource TextFaintBrush}" StrokeThickness="1" Fill="White" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimarySoftBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="Dot" Property="StrokeThickness" Value="3" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryHoverBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- モード + 説明 -->
        <DockPanel Grid.Row="0" Margin="20,16,20,14">
            <StackPanel Orientation="Horizontal">
                <RadioButton GroupName="RangeMode" Style="{StaticResource ModeRadioStyle}"
                             Content="エリアログ区間"
                             IsChecked="{Binding IsAreaSegmentMode}"
                             IsEnabled="{Binding HasAreaSegments}" />
                <RadioButton GroupName="RangeMode" Style="{StaticResource ModeRadioStyle}"
                             Content="手動範囲指定"
                             IsChecked="{Binding IsManualRangeMode}" />
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" MaxWidth="560"
                           Style="{StaticResource FieldLabelStyle}" TextWrapping="Wrap"
                           Text="エリアチェンジ行の直後から次のエリアチェンジ行の直前まで。時刻ではなくログ順序で区切ります。" />
            </StackPanel>
        </DockPanel>

        <!-- 本体（エリアログ区間モード） -->
        <Grid Grid.Row="1" Margin="20,0"
              Visibility="{Binding IsAreaSegmentMode, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeaderBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="エリアログ区間" />
                                <TextBlock Margin="8,0,0,0" Style="{StaticResource CaptionTextStyle}"
                                           Foreground="{StaticResource TextFaintBrush}"
                                           Text="{Binding FilteredSegmentCountText}" />
                            </StackPanel>
                            <CheckBox Grid.Row="0" Grid.Column="2" Margin="0" VerticalAlignment="Center"
                                      Style="{StaticResource AppCheckBoxStyle}" FontSize="12"
                                      IsChecked="{Binding HideSmallSegments}"
                                      Content="100件未満の区間を隠す" />
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,9,0,0"
                                        Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Margin="0,0,8,0" Style="{StaticResource FieldLabelStyle}"
                                           Text="絞り込み" />
                                <TextBox x:Name="AreaFilterTextBox"
                                         Width="260" Height="30"
                                         Style="{StaticResource AppTextBoxStyle}"
                                         Text="{Binding AreaFilterText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="エリア名を入力して絞り込み"
                                         AutomationProperties.Name="エリア名で絞り込み" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border DockPanel.Dock="Bottom" Padding="14,8"
                            BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0">
                        <TextBlock Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"
                                   Text="{Binding SelectedAreaSummary}" />
                    </Border>
                    <DataGrid Style="{StaticResource AppDataGridStyle}" IsReadOnly="True"
                              ItemsSource="{Binding FilteredAreaSegments}"
                              SelectedItem="{Binding SelectedAreaSegment}"
                              MouseDoubleClick="OnAreaSegmentDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Width="48" Binding="{Binding Sequence}"
                                                ElementStyle="{StaticResource NumericCellStyle}"
                                                HeaderStyle="{StaticResource NumericColumnHeaderStyle}" />
                            <DataGridTextColumn Header="エリア" Width="*" Binding="{Binding AreaName}" />
                            <DataGridTextColumn Header="訪問" Width="80" Binding="{Binding OccurrenceText}" />
                            <DataGridTextColumn Header="開始時刻" Width="110" Binding="{Binding FirstMessageTimeText}" />
                            <DataGridTextColumn Header="ログ件数" Width="100"
                                                Binding="{Binding RecordCount, StringFormat={}{0:N0}}"
                                                ElementStyle="{StaticResource NumericCellStyle}"
                                                HeaderStyle="{StaticResource NumericColumnHeaderStyle}" />
                            <DataGridTextColumn Header="ログ順の範囲" Width="150" Binding="{Binding OrderRangeText}"
                                                ElementStyle="{StaticResource NumericCellStyle}"
                                                HeaderStyle="{StaticResource NumericColumnHeaderStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- 右ペイン -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}"
                        DataContext="{Binding SelectedAreaSegment}">
                    <StackPanel>
                        <Border Style="{StaticResource CardHeaderBorderStyle}">
                            <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="選択中の区間" />
                        </Border>
                        <StackPanel Margin="14,12,14,10">
                            <TextBlock FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding AreaName}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,3,0,0"
                                       Text="{Binding OccurrenceText}" />
                            <StackPanel Margin="0,10,0,0">
                                <Border Style="{StaticResource RowDividerBorderStyle}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource FieldLabelStyle}" Text="ログ順の範囲" />
                                        <TextBlock Style="{StaticResource ValueTextStyle}" FontSize="13" Text="{Binding OrderRangeText}" />
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource RowDividerBorderStyle}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource FieldLabelStyle}" Text="ログ件数" />
                                        <TextBlock Style="{StaticResource ValueTextStyle}" FontSize="13"
                                                   Text="{Binding RecordCount, StringFormat={}{0:N0}}" />
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource RowDividerBorderStyle}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource FieldLabelStyle}" Text="時刻" />
                                        <TextBlock Style="{StaticResource ValueTextStyle}" FontSize="13" Text="{Binding TimeRangeText}" />
                                    </DockPanel>
                                </Border>
                                <DockPanel Margin="0,6">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource FieldLabelStyle}" Text="経過" />
                                    <TextBlock Style="{StaticResource ValueTextStyle}" FontSize="13" Text="{Binding ElapsedText}" />
                                </DockPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource CardHeaderBorderStyle}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource CaptionTextStyle}"
                                           Foreground="{StaticResource TextFaintBrush}" Text="先頭5行" />
                                <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="区間の先頭ログ" />
                            </DockPanel>
                        </Border>
                        <ItemsControl Margin="14,9" ItemsSource="{Binding SelectedSegmentPreviewLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontFamily="{StaticResource MonoFontFamily}" FontSize="11"
                                               LineHeight="19"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Text="{Binding}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- 本体（手動範囲指定モード）: 既存実装を CardBorderStyle でラップしたもの -->
        <Grid Grid.Row="1" Margin="20,0"
              Visibility="{Binding IsManualRangeMode, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                <DataGrid Style="{StaticResource AppDataGridStyle}" IsReadOnly="True" ItemsSource="{Binding Markers}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="セッションID" Width="150" Binding="{Binding SessionId}" />
                        <DataGridTextColumn Header="ログ順序" Width="90" Binding="{Binding Order}"
                                            ElementStyle="{StaticResource NumericCellStyle}"
                                            HeaderStyle="{StaticResource NumericColumnHeaderStyle}" />
                        <DataGridTextColumn Header="マーカー" Width="140" Binding="{Binding MarkerKeyword}" />
                        <DataGridTextColumn Header="ログ本文" Width="*" Binding="{Binding VisibleText}" />
                        <DataGridTextColumn Header="ログ内時刻" Width="120" Binding="{Binding MessageTimeText}" />
                        <DataGridTextColumn Header="初回検出時刻" Width="160" Binding="{Binding FirstSeenAt}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <Border Style="{StaticResource CardHeaderBorderStyle}">
                            <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="開始ポイント" />
                        </Border>
                        <StackPanel Margin="14,12">
                            <RadioButton Margin="0,0,0,8" Style="{StaticResource AppRadioButtonStyle}" IsChecked="{Binding IsStartLogStart}" Content="ログ先頭" />
                            <RadioButton Margin="0,0,0,8" Style="{StaticResource AppRadioButtonStyle}" IsChecked="{Binding IsStartMarker}" Content="マーカー" />
                            <ComboBox Style="{StaticResource AppComboBoxStyle}"
                                      ItemsSource="{Binding Markers}" SelectedItem="{Binding SelectedStartMarker}"
                                      DisplayMemberPath="VisibleText" IsEnabled="{Binding IsStartMarker}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,14,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource CardHeaderBorderStyle}">
                            <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="終了ポイント" />
                        </Border>
                        <StackPanel Margin="14,12">
                            <RadioButton Margin="0,0,0,8" Style="{StaticResource AppRadioButtonStyle}" IsChecked="{Binding IsEndMarker}" Content="マーカー" />
                            <ComboBox Style="{StaticResource AppComboBoxStyle}" Margin="0,0,0,10"
                                      ItemsSource="{Binding EndMarkerCandidates}" SelectedItem="{Binding SelectedEndMarker}"
                                      DisplayMemberPath="VisibleText" IsEnabled="{Binding IsEndMarker}" />
                            <RadioButton Margin="0" Style="{StaticResource AppRadioButtonStyle}" IsChecked="{Binding IsEndLogEnd}" Content="ログ最後尾" />
                            <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,10,0,0" TextWrapping="Wrap"
                                       Text="終了マーカー候補には、開始マーカーより後ろのマーカーのみ表示されます。" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- フッター -->
        <Border Grid.Row="2" Margin="0,14,0,0" Padding="20,12"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushFooter}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Left" Margin="0,0,12,0" Style="{StaticResource SecondaryButtonStyle}" Height="36"
                        Command="{Binding GoBackCommand}" Content="← セッション選択へ戻る" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButtonStyle}" Height="36" Margin="0,0,8,0"
                            Command="{Binding CancelAnalysisCommand}" Content="キャンセル"
                            Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Style="{StaticResource PrimaryButtonStyle}" Width="128"
                            Command="{Binding RunAnalysisCommand}" Content="分析実行" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource FieldLabelStyle}" TextWrapping="Wrap" Text="{Binding ValidationMessage}" />
                    <TextBlock Style="{StaticResource FieldLabelStyle}" TextWrapping="Wrap" Text="{Binding RangeSummary}" />
                    <ProgressBar Height="4" Margin="0,6,0,0" IsIndeterminate="True" BorderThickness="0"
                                 Background="#FFEAECF0" Foreground="{StaticResource PrimaryBrush}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
