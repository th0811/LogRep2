<UserControl x:Class="FFXI_LogAnalyzer.App.AnalysisRangeSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="420"
             d:DesignWidth="900">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="RightAlignedCellText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="エリアログ区間は、エリアチェンジ行の直後から次のエリアチェンジ行の直前までです。時刻ではなくログ順序で区切ります。"
                       TextWrapping="Wrap" />
            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                <RadioButton GroupName="RangeMode" Margin="0,0,16,0"
                             Content="手動範囲指定" IsChecked="{Binding IsManualRangeMode}" />
                <RadioButton GroupName="RangeMode"
                             Content="エリアログ区間" IsChecked="{Binding IsAreaSegmentMode}"
                             IsEnabled="{Binding HasAreaSegments}" />
            </StackPanel>
            <DockPanel Margin="0,8,0,0"
                       Visibility="{Binding IsAreaSegmentMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center" Text="エリア名で絞り込み" />
                <TextBox Text="{Binding AreaFilterText, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
        </StackPanel>

        <Grid Grid.Row="1"
              Visibility="{Binding IsManualRangeMode, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0" ItemsSource="{Binding Markers}" AutoGenerateColumns="False"
                      CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="セッションID" Binding="{Binding SessionId}" Width="140" />
                    <DataGridTextColumn Header="ログ順序" Binding="{Binding Order}" Width="80" />
                    <DataGridTextColumn Header="マーカー" Binding="{Binding MarkerKeyword}" Width="140" />
                    <DataGridTextColumn Header="ログ本文" Binding="{Binding VisibleText}" Width="*" />
                    <DataGridTextColumn Header="ログ内時刻" Binding="{Binding MessageTimeText}" Width="140" />
                    <DataGridTextColumn Header="初回検出時刻" Binding="{Binding FirstSeenAt}" Width="180" />
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <GroupBox Header="開始ポイント" Margin="0,0,0,10">
                    <StackPanel Margin="8">
                        <RadioButton Content="ログ先頭" IsChecked="{Binding IsStartLogStart}" Margin="0,0,0,6" />
                        <RadioButton Content="マーカー" IsChecked="{Binding IsStartMarker}" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding Markers}" SelectedItem="{Binding SelectedStartMarker}"
                                  DisplayMemberPath="VisibleText" IsEnabled="{Binding IsStartMarker}" />
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="終了ポイント">
                    <StackPanel Margin="8">
                        <RadioButton Content="マーカー" IsChecked="{Binding IsEndMarker}" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding EndMarkerCandidates}" SelectedItem="{Binding SelectedEndMarker}"
                                  DisplayMemberPath="VisibleText" IsEnabled="{Binding IsEndMarker}" Margin="0,0,0,8" />
                        <RadioButton Content="ログ最後尾" IsChecked="{Binding IsEndLogEnd}" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1"
              Visibility="{Binding IsAreaSegmentMode, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DataGrid Grid.Row="0" ItemsSource="{Binding FilteredAreaSegments}"
                      SelectedItem="{Binding SelectedAreaSegment}" AutoGenerateColumns="False"
                      CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single"
                      SelectionUnit="FullRow" HeadersVisibility="Column"
                      MouseDoubleClick="OnAreaSegmentDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Sequence}" Width="48"
                                        ElementStyle="{StaticResource RightAlignedCellText}" />
                    <DataGridTextColumn Header="エリア" Binding="{Binding AreaName}" Width="*" />
                    <DataGridTextColumn Header="訪問" Binding="{Binding OccurrenceText}" Width="80" />
                    <DataGridTextColumn Header="先頭ログ時刻" Binding="{Binding FirstMessageTimeText}" Width="130" />
                    <DataGridTextColumn Header="ログ件数" Binding="{Binding RecordCount, StringFormat={}{0:N0}}" Width="90"
                                        ElementStyle="{StaticResource RightAlignedCellText}" />
                    <DataGridTextColumn Header="ログ順の範囲" Binding="{Binding OrderRangeText}" Width="150" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Row="1" Margin="0,8,0,0" Text="{Binding SelectedAreaSummary}" TextWrapping="Wrap" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap" />
                <ProgressBar Height="12" Margin="0,8,0,0" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Text="{Binding RangeSummary}" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="分析実行" Command="{Binding RunAnalysisCommand}" />
                <Button Margin="8,0,0,0" Content="キャンセル" Command="{Binding CancelAnalysisCommand}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="3" Margin="0,8,0,0"
                   Text="終了マーカー候補には、開始マーカーより後ろのマーカーのみ表示されます。"
                   TextWrapping="Wrap"
                   Visibility="{Binding IsManualRangeMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </Grid>
</UserControl>
