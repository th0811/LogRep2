<!--
  ③ 分析結果。上部の条件バーに分析条件を要約し、CSV出力は分割ボタンに統合。
  キャラクター選択は絞り込み＋分類チェック＋リンク風チップ。
-->
<UserControl x:Class="FFXI_LogAnalyzer.App.AnalysisResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:FFXI_LogAnalyzer.App"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              mc:Ignorable="d"
              d:DesignHeight="560" d:DesignWidth="1160"
              FontFamily="{StaticResource UiFontFamily}"
              UseLayoutRounding="True"
              SnapsToDevicePixels="True"
              TextOptions.TextFormattingMode="Display"
              TextOptions.TextRenderingMode="ClearType">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== 条件バー ===== -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushDefault}" BorderThickness="0,0,0,1"
                Padding="20,9">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Border CornerRadius="10" Padding="9,5" Margin="0,0,10,0"
                            Background="{StaticResource WarningSoftBrush}"
                            BorderBrush="{StaticResource WarningBorderBrush}" BorderThickness="1"
                            Visibility="{Binding HasUnparsedLogs, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource WarningBrush}"
                                   Text="{Binding UnparsedCountText}" />
                    </Border>
                    <!-- CSV 出力（分割ボタン） -->
                    <Button Style="{StaticResource ToolbarButtonStyle}" Height="30" Margin="0"
                            Click="OnSplitButtonClick"
                            IsEnabled="{Binding HasResult}"
                            ToolTip="出力する種類を選びます">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="キャラクター別CSV" Command="{Binding ExportActorSummariesCommand}" />
                                <MenuItem Header="アクション別CSV" Command="{Binding ExportActionSummariesCommand}" />
                                <MenuItem Header="レベル上げCSV" Command="{Binding ExportLevelingPointsCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="CSV出力" VerticalAlignment="Center" />
                            <Border Width="1" Height="16" Margin="8,0" Background="{StaticResource BorderBrushDefault}" />
                            <TextBlock Text="▼" FontSize="9" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="区間" />
                    <TextBlock Margin="6,0,18,0" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding RangeLabel}" />
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="ログ順" />
                    <TextBlock Margin="6,0,18,0" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"
                               Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding OrderRangeText}" />
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="件数" />
                    <TextBlock Margin="6,0,18,0" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"
                               Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding RecordCountText}" />
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="経過" />
                    <TextBlock Margin="6,0,0,0" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"
                               Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding ElapsedText}" />
                    <TextBlock Margin="12,0,0,0" Style="{StaticResource FieldLabelStyle}"
                               Text="{Binding ExclusionSummary}" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- ===== 結果タブ ===== -->
        <TabControl Grid.Row="1" Margin="20,14,20,0" Style="{StaticResource ResultTabControlStyle}">

            <TabItem Header="キャラクター別サマリ">
                <Border Style="{StaticResource CardBorderStyle}" CornerRadius="0,6,6,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" MinWidth="380" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="7*" MinWidth="520" />
                        </Grid.ColumnDefinitions>

                        <!-- キャラクター選択 -->
                        <DockPanel Grid.Column="0">
                            <Border DockPanel.Dock="Top" Style="{StaticResource CardHeaderBorderStyle}" Padding="13,11">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                                        <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="キャラクター選択" />
                                        <TextBlock Margin="8,0,0,0" Style="{StaticResource CaptionTextStyle}"
                                                   Foreground="{StaticResource TextFaintBrush}"
                                                   Text="{Binding ActorSelectionSummary}" />
                                    </StackPanel>
                                    <TextBox Style="{StaticResource AppTextBoxStyle}"
                                             Background="{StaticResource SurfaceSubtleBrush}"
                                             BorderBrush="{StaticResource BorderBrushDefault}"
                                             Text="{Binding ActorFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="名前で絞り込み" />
                                    <WrapPanel Margin="0,9,0,0">
                                        <CheckBox Style="{StaticResource AppCheckBoxStyle}" Margin="0,0,12,4" FontSize="12"
                                                  Content="PC登録" IsChecked="{Binding ShowRegisteredPcActors, Mode=TwoWay}" />
                                        <CheckBox Style="{StaticResource AppCheckBoxStyle}" Margin="0,0,12,4" FontSize="12"
                                                  Content="PC候補" IsChecked="{Binding ShowPcCandidateActors, Mode=TwoWay}" />
                                        <CheckBox Style="{StaticResource AppCheckBoxStyle}" Margin="0,0,12,4" FontSize="12"
                                                  Content="NPC登録" IsChecked="{Binding ShowRegisteredNpcActors, Mode=TwoWay}" />
                                        <CheckBox Style="{StaticResource AppCheckBoxStyle}" Margin="0,0,0,4" FontSize="12"
                                                  Content="未分類" IsChecked="{Binding ShowUnknownActors, Mode=TwoWay}" />
                                    </WrapPanel>
                                    <WrapPanel Margin="0,5,0,0">
                                        <Button Style="{StaticResource LinkButtonStyle}" Content="すべて選択" Command="{Binding SelectAllActorsCommand}" />
                                        <Button Style="{StaticResource LinkButtonStyle}" Content="解除" Command="{Binding ClearActorSelectionCommand}" />
                                        <Button Style="{StaticResource LinkButtonStyle}" Content="PC候補のみ" Command="{Binding SelectPcCandidateActorsCommand}" />
                                        <Button Style="{StaticResource LinkButtonStyle}" Content="登録済みPCのみ" Command="{Binding SelectRegisteredPcActorsCommand}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border DockPanel.Dock="Bottom" Padding="13,9"
                                    BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0">
                                <Button HorizontalAlignment="Left" Style="{StaticResource SmallButtonStyle}" Height="28"
                                        Command="{Binding OpenActorRegistrationManagerCommand}" Content="登録名管理" />
                            </Border>

                            <ListBox Style="{StaticResource AppListBoxStyle}"
                                     ItemContainerStyle="{StaticResource AppListBoxItemStyle}"
                                     ItemsSource="{Binding FilteredActorVisibilities}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <DockPanel.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="PC名として登録"
                                                              Command="{Binding PlacementTarget.DataContext.RegisterAsPcCommand,
                                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <MenuItem Header="NPC名として登録"
                                                              Command="{Binding PlacementTarget.DataContext.RegisterAsNpcCommand,
                                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <MenuItem Header="登録を解除"
                                                              Command="{Binding PlacementTarget.DataContext.ClearRegistrationCommand,
                                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                </ContextMenu>
                                            </DockPanel.ContextMenu>
                                            <Button DockPanel.Dock="Right"
                                                    Width="54" Height="26" MinWidth="0"
                                                    Margin="8,0,0,0"
                                                    Padding="6,2"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource SmallButtonStyle}"
                                                    Click="OnSplitButtonClick"
                                                    Content="登録…"
                                                    ToolTip="PC・NPCの登録状態を変更">
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="PC名として登録"
                                                                  Command="{Binding PlacementTarget.DataContext.RegisterAsPcCommand,
                                                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        <MenuItem Header="NPC名として登録"
                                                                  Command="{Binding PlacementTarget.DataContext.RegisterAsNpcCommand,
                                                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        <MenuItem Header="登録を解除"
                                                                  Command="{Binding PlacementTarget.DataContext.ClearRegistrationCommand,
                                                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                            <!-- 分類バッジ -->
                                            <Border DockPanel.Dock="Right" CornerRadius="9" Padding="7,2" VerticalAlignment="Center"
                                                    Background="{Binding ClassificationBackground}">
                                                <TextBlock FontSize="11"
                                                           Foreground="{Binding ClassificationForeground}"
                                                           Text="{Binding ClassificationLabel}" />
                                            </Border>
                                            <CheckBox VerticalAlignment="Center"
                                                      IsChecked="{Binding IsVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                <TextBlock Text="{Binding Actor}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Actor}" />
                                            </CheckBox>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                      Background="{StaticResource BorderBrushSoft}"
                                      ResizeBehavior="PreviousAndNext"
                                      ResizeDirection="Columns" />

                        <DataGrid Grid.Column="2" Style="{StaticResource AppDataGridStyle}" IsReadOnly="True"
                                  ItemsSource="{Binding ActorSummaries}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="キャラクター名" Width="150" Binding="{Binding Actor}" />
                                <DataGridTextColumn Header="総与ダメージ" Width="118" Binding="{Binding TotalDamage}"
                                                    ElementStyle="{StaticResource NumericCellStyle}" HeaderStyle="{StaticResource NumericColumnHeaderStyle}" />
                                <DataGridTextColumn Header="DPS" Width="96" Binding="{Binding Dps}"
                                                    ElementStyle="{StaticResource NumericCellStyle}" HeaderStyle="{StaticResource NumericColumnHeaderStyle}" />
                                <DataGridTextColumn Header="DPS時間精度" Width="110" Binding="{Binding DpsTimeConfidence}" />
                                <DataGridTextColumn Header="通常攻撃命中率" Width="128" Binding="{Binding NormalAttackHitRate}"
                                                    ElementStyle="{StaticResource NumericCellStyle}" HeaderStyle="{StaticResource NumericColumnHeaderStyle}" />
                                <DataGridTextColumn Header="通常攻撃クリティカル率" Width="150" Binding="{Binding NormalAttackCriticalRate}"
                                                    ElementStyle="{StaticResource NumericCellStyle}" HeaderStyle="{StaticResource NumericColumnHeaderStyle}" />
                                <DataGridTextColumn Header="未分類件数" Width="100" Binding="{Binding UnknownCount}"
                                                    ElementStyle="{StaticResource NumericCellStyle}" HeaderStyle="{StaticResource NumericColumnHeaderStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="技/魔法/通常攻撃別集計">
                <Border Style="{StaticResource CardBorderStyle}" CornerRadius="0,6,6,6">
                    <DataGrid Style="{StaticResource AppDataGridStyle}" IsReadOnly="True" ItemsSource="{Binding ActionSummaries}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="キャラクター名" Width="140" Binding="{Binding Actor}" />
                            <DataGridTextColumn Header="アクション名" Width="170" Binding="{Binding ActionName}" />
                            <DataGridTextColumn Header="種別" Width="140" Binding="{Binding ActionType}" />
                            <DataGridTextColumn Header="使用回数" Width="90" Binding="{Binding UseCount}" ElementStyle="{StaticResource NumericCellStyle}" HeaderStyle="{StaticResource NumericColumnHeaderStyle}" />
                            <DataGridTextColumn Header="命中回数" Width="90" Binding="{Binding HitCount}" ElementStyle="{StaticResource NumericCellStyle}" HeaderStyle="{StaticResource NumericColumnHeaderStyle}" />
                            <DataGridTextColumn Header="非命中回数" Width="100" Binding="{Binding MissCount}" ElementStyle="{StaticResource NumericCellStyle}" HeaderStyle="{StaticResource NumericColumnHeaderStyle}" />
                            <DataGridTextColumn Header="未分類件数" Width="100" Binding="{Binding UnknownCount}" ElementStyle="{StaticResource NumericCellStyle}" HeaderStyle="{StaticResource NumericColumnHeaderStyle}" />
                            <DataGridTextColumn Header="命中率" Width="90" Binding="{Binding HitRate}" ElementStyle="{StaticResource NumericCellStyle}" HeaderStyle="{StaticResource NumericColumnHeaderStyle}" />
                            <DataGridTextColumn Header="総ダメージ" Width="100" Binding="{Binding TotalDamage}" ElementStyle="{StaticResource NumericCellStyle}" HeaderStyle="{StaticResource NumericColumnHeaderStyle}" />
                            <DataGridTextColumn Header="最大ダメージ" Width="100" Binding="{Binding MaxDamage}" ElementStyle="{StaticResource NumericCellStyle}" HeaderStyle="{StaticResource NumericColumnHeaderStyle}" />
                            <DataGridTextColumn Header="最小ダメージ" Width="100" Binding="{Binding MinDamage}" ElementStyle="{StaticResource NumericCellStyle}" HeaderStyle="{StaticResource NumericColumnHeaderStyle}" />
                            <DataGridTextColumn Header="平均ダメージ" Width="110" Binding="{Binding AverageDamage}" ElementStyle="{StaticResource NumericCellStyle}" HeaderStyle="{StaticResource NumericColumnHeaderStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

            <TabItem Header="ポイント">
                <Border Style="{StaticResource CardBorderStyle}" CornerRadius="0,6,6,6">
                    <DataGrid Style="{StaticResource AppDataGridStyle}" IsReadOnly="True" ItemsSource="{Binding LevelingPointSummaries}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ポイント種別" Width="220" Binding="{Binding PointName}" />
                            <DataGridTextColumn Header="総合計" Width="140" Binding="{Binding TotalPoints}" ElementStyle="{StaticResource NumericCellStyle}" HeaderStyle="{StaticResource NumericColumnHeaderStyle}" />
                            <DataGridTextColumn Header="最大チェーン" Width="140" Binding="{Binding MaxChainCount}" ElementStyle="{StaticResource NumericCellStyle}" HeaderStyle="{StaticResource NumericColumnHeaderStyle}" />
                            <DataGridTextColumn Header="時給" Width="140" Binding="{Binding PointsPerHour}" ElementStyle="{StaticResource NumericCellStyle}" HeaderStyle="{StaticResource NumericColumnHeaderStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

            <TabItem Header="未解析ログ">
                <Border Style="{StaticResource CardBorderStyle}" CornerRadius="0,6,6,6">
                    <local:UnparsedLogView />
                </Border>
            </TabItem>

            <TabItem Header="セッション情報">
                <Border Style="{StaticResource CardBorderStyle}" CornerRadius="0,6,6,6">
                    <DataGrid Style="{StaticResource AppDataGridStyle}" IsReadOnly="True" ItemsSource="{Binding SessionRows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="項目" Width="240" Binding="{Binding Label}" />
                            <DataGridTextColumn Header="値" Width="*" Binding="{Binding Value}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- ===== フッター ===== -->
        <Border Grid.Row="2" Margin="0,14,0,0" Padding="20,12"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushFooter}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Left" Margin="0,0,12,0" Style="{StaticResource SecondaryButtonStyle}" Height="36"
                        Command="{Binding GoBackCommand}" Content="← 分析区間へ戻る" />
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButtonStyle}" Width="128"
                        Command="{Binding ExportActorSummariesCommand}" Content="CSV出力" />
                <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding StatusMessage}" ToolTip="{Binding StatusMessage}" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
