<UserControl x:Class="FFXI_LogAnalyzer.App.AnalysisResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:FFXI_LogAnalyzer.App"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="420"
             d:DesignWidth="900">
    <UserControl.Resources>
        <Style x:Key="CompactButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="96" />
        </Style>
        <Style x:Key="FilterCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,12,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="NumericCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
        <Style x:Key="NumericHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="Padding" Value="4,0" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource CompactButtonStyle}"
                        Content="キャラクター別CSV"
                        Command="{Binding ExportActorSummariesCommand}" />
                <Button Style="{StaticResource CompactButtonStyle}"
                        Content="アクション別CSV"
                        Command="{Binding ExportActionSummariesCommand}" />
                <Button Style="{StaticResource CompactButtonStyle}"
                        Content="レベル上げCSV"
                        Command="{Binding ExportLevelingPointsCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}"
                       FontWeight="Bold" />
        </DockPanel>

        <TabControl>
            <TabItem Header="キャラクター別サマリ">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" MinWidth="220" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="7*" />
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0"
                              Header="キャラクター選択"
                              Padding="8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Margin="0,0,0,8"
                                           Foreground="#4B5563"
                                           Text="表示するキャラクターを選択します。「登録…」からPC・NPCの分類を変更できます。"
                                           TextWrapping="Wrap" />
                                <TextBox Text="{Binding ActorFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         MinWidth="220"
                                         Margin="0,0,0,8" />

                                <WrapPanel Margin="0,0,0,4">
                                    <CheckBox Style="{StaticResource FilterCheckBoxStyle}"
                                              Content="PC登録"
                                              IsChecked="{Binding ShowRegisteredPcActors, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Style="{StaticResource FilterCheckBoxStyle}"
                                              Content="PC候補"
                                              IsChecked="{Binding ShowPcCandidateActors, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Style="{StaticResource FilterCheckBoxStyle}"
                                              Content="NPC登録"
                                              IsChecked="{Binding ShowRegisteredNpcActors, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Style="{StaticResource FilterCheckBoxStyle}"
                                              Content="未分類"
                                              IsChecked="{Binding ShowUnknownActors, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </WrapPanel>

                                <UniformGrid Columns="2"
                                             Margin="0,0,0,8">
                                    <Button Style="{StaticResource CompactButtonStyle}"
                                            Content="すべて選択"
                                            Command="{Binding SelectAllActorsCommand}" />
                                    <Button Style="{StaticResource CompactButtonStyle}"
                                            Content="すべて解除"
                                            Command="{Binding ClearActorSelectionCommand}" />
                                    <Button Style="{StaticResource CompactButtonStyle}"
                                            Content="PC候補を選択"
                                            Command="{Binding SelectPcCandidateActorsCommand}" />
                                    <Button Style="{StaticResource CompactButtonStyle}"
                                            Content="登録済みPCのみ"
                                            Command="{Binding SelectRegisteredPcActorsCommand}" />
                                </UniformGrid>

                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Left"
                                            Style="{StaticResource CompactButtonStyle}"
                                            Content="登録名管理"
                                            Command="{Binding OpenActorRegistrationManagerCommand}" />
                                    <TextBlock Text="{Binding ActorSelectionSummary}"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0" />
                                </DockPanel>
                            </StackPanel>

                            <ListBox ItemsSource="{Binding FilteredActorVisibilities}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="4"
                                                BorderBrush="#E5E7EB"
                                                BorderThickness="0,0,0,1">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="PC名として登録"
                                                              Command="{Binding PlacementTarget.DataContext.RegisterAsPcCommand,
                                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <MenuItem Header="NPC名として登録"
                                                              Command="{Binding PlacementTarget.DataContext.RegisterAsNpcCommand,
                                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <MenuItem Header="登録を解除"
                                                              Command="{Binding PlacementTarget.DataContext.ClearRegistrationCommand,
                                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                </ContextMenu>
                                            </Border.ContextMenu>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="72" />
                                                    <ColumnDefinition Width="60" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0"
                                                          IsChecked="{Binding IsVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Actor}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Actor}" />
                                                </CheckBox>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding ClassificationLabel}"
                                                           Margin="4,0"
                                                           HorizontalAlignment="Stretch"
                                                           VerticalAlignment="Center"
                                                           Padding="8,2"
                                                           TextAlignment="Center"
                                                           Foreground="{Binding ClassificationForeground}"
                                                           Background="{Binding ClassificationBackground}" />
                                                <Button Grid.Column="2"
                                                        Width="56"
                                                        MinWidth="0"
                                                        Margin="4,0,0,0"
                                                        Padding="6,2"
                                                        VerticalAlignment="Center"
                                                        Click="OnRegistrationButtonClick"
                                                        Content="登録…"
                                                        ToolTip="PC・NPCの登録状態を変更">
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="PC名として登録"
                                                                      Command="{Binding PlacementTarget.DataContext.RegisterAsPcCommand,
                                                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                            <MenuItem Header="NPC名として登録"
                                                                      Command="{Binding PlacementTarget.DataContext.RegisterAsNpcCommand,
                                                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                            <MenuItem Header="登録を解除"
                                                                      Command="{Binding PlacementTarget.DataContext.ClearRegistrationCommand,
                                                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </GroupBox>

                    <GridSplitter Grid.Column="1"
                                  Width="4"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Stretch"
                                  Background="#D1D5DB" />

                    <DataGrid Grid.Column="2"
                              ItemsSource="{Binding ActorSummaries}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="キャラクター名" Binding="{Binding Actor}" Width="150" />
                            <DataGridTextColumn Header="総与ダメージ" Binding="{Binding TotalDamage}" Width="110" ElementStyle="{StaticResource NumericCellStyle}" HeaderStyle="{StaticResource NumericHeaderStyle}" />
                            <DataGridTextColumn Header="DPS" Binding="{Binding Dps}" Width="90" ElementStyle="{StaticResource NumericCellStyle}" HeaderStyle="{StaticResource NumericHeaderStyle}" />
                            <DataGridTextColumn Header="DPS時間精度" Binding="{Binding DpsTimeConfidence}" Width="120" />
                            <DataGridTextColumn Header="通常攻撃命中率" Binding="{Binding NormalAttackHitRate}" Width="150" ElementStyle="{StaticResource NumericCellStyle}" HeaderStyle="{StaticResource NumericHeaderStyle}" />
                            <DataGridTextColumn Header="通常攻撃クリティカル率" Binding="{Binding NormalAttackCriticalRate}" Width="170" ElementStyle="{StaticResource NumericCellStyle}" HeaderStyle="{StaticResource NumericHeaderStyle}" />
                            <DataGridTextColumn Header="未分類件数" Binding="{Binding UnknownCount}" Width="100" ElementStyle="{StaticResource NumericCellStyle}" HeaderStyle="{StaticResource NumericHeaderStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="技/魔法/通常攻撃別集計">
                <DataGrid ItemsSource="{Binding ActionSummaries}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="キャラクター名" Binding="{Binding Actor}" Width="140" />
                        <DataGridTextColumn Header="アクション名" Binding="{Binding ActionName}" Width="170" />
                        <DataGridTextColumn Header="種別" Binding="{Binding ActionType}" Width="140" />
                        <DataGridTextColumn Header="使用回数" Binding="{Binding UseCount}" Width="90" ElementStyle="{StaticResource NumericCellStyle}" HeaderStyle="{StaticResource NumericHeaderStyle}" />
                        <DataGridTextColumn Header="命中回数" Binding="{Binding HitCount}" Width="90" ElementStyle="{StaticResource NumericCellStyle}" HeaderStyle="{StaticResource NumericHeaderStyle}" />
                        <DataGridTextColumn Header="非命中回数" Binding="{Binding MissCount}" Width="100" ElementStyle="{StaticResource NumericCellStyle}" HeaderStyle="{StaticResource NumericHeaderStyle}" />
                        <DataGridTextColumn Header="未分類件数" Binding="{Binding UnknownCount}" Width="100" ElementStyle="{StaticResource NumericCellStyle}" HeaderStyle="{StaticResource NumericHeaderStyle}" />
                        <DataGridTextColumn Header="命中率" Binding="{Binding HitRate}" Width="90" ElementStyle="{StaticResource NumericCellStyle}" HeaderStyle="{StaticResource NumericHeaderStyle}" />
                        <DataGridTextColumn Header="総ダメージ" Binding="{Binding TotalDamage}" Width="100" ElementStyle="{StaticResource NumericCellStyle}" HeaderStyle="{StaticResource NumericHeaderStyle}" />
                        <DataGridTextColumn Header="最大ダメージ" Binding="{Binding MaxDamage}" Width="100" ElementStyle="{StaticResource NumericCellStyle}" HeaderStyle="{StaticResource NumericHeaderStyle}" />
                        <DataGridTextColumn Header="最小ダメージ" Binding="{Binding MinDamage}" Width="100" ElementStyle="{StaticResource NumericCellStyle}" HeaderStyle="{StaticResource NumericHeaderStyle}" />
                        <DataGridTextColumn Header="平均ダメージ" Binding="{Binding AverageDamage}" Width="100" ElementStyle="{StaticResource NumericCellStyle}" HeaderStyle="{StaticResource NumericHeaderStyle}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="レベル上げ">
                <DataGrid ItemsSource="{Binding LevelingPointSummaries}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ポイント種別" Binding="{Binding PointName}" Width="220" />
                        <DataGridTextColumn Header="総合計" Binding="{Binding TotalPoints}" Width="140" ElementStyle="{StaticResource NumericCellStyle}" HeaderStyle="{StaticResource NumericHeaderStyle}" />
                        <DataGridTextColumn Header="最大チェーン" Binding="{Binding MaxChainCount}" Width="140" ElementStyle="{StaticResource NumericCellStyle}" HeaderStyle="{StaticResource NumericHeaderStyle}" />
                        <DataGridTextColumn Header="時給" Binding="{Binding PointsPerHour}" Width="140" ElementStyle="{StaticResource NumericCellStyle}" HeaderStyle="{StaticResource NumericHeaderStyle}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="未解析ログ">
                <local:UnparsedLogView />
            </TabItem>

            <TabItem Header="セッション情報">
                <DataGrid ItemsSource="{Binding SessionRows}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="項目" Binding="{Binding Label}" Width="240" />
                        <DataGridTextColumn Header="値" Binding="{Binding Value}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
